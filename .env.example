# Copy to a user environment variable. Do not commit a real .env with secrets.

# Azure DevOps organization name only (the org slug, not the full URL).
# Example: if your URL is https://dev.azure.com/contoso then set ADO_ORG=contoso
ADO_ORG=your-org

# Personal Access Token with Work Items (Read & Write) and Test Management as needed.
# Never commit this value. Set it as a Windows user environment variable instead:
#   [Environment]::SetEnvironmentVariable("AZURE_DEVOPS_EXT_PAT", "<PAT>", "User")
AZURE_DEVOPS_EXT_PAT=
